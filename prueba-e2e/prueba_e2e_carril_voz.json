    {
      "id": "37698fef-f09d-40fa-893e-652e7e6442fd",
      "name": "Tope 200 Caracteres (guardrail)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1280,
        200
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "tp1",
              "name": "respuesta_voz",
              "value": "={{ (() => { const t = String($json.output ?? '').replace(/[*_#`|>]/g, '').replace(/\\s+/g, ' ').trim(); if (t.length <= 200) return t; const c = t.slice(0, 200); const m = [...c.matchAll(/[.!?](?=\\s|$)/g)].pop(); return m && m.index >= 60 ? c.slice(0, m.index + 1) : c.slice(0, c.lastIndexOf(' ')).trim() + '.'; })() }}",
              "type": "string"
            },
            {
              "id": "tp2",
              "name": "chat_id",
              "value": "={{ $('Telegram Trigger (Notas de Voz)').first().json.message.chat.id }}",
              "type": "string"
            },
            {
              "id": "tp3",
              "name": "message_id",
              "value": "={{ $('Telegram Trigger (Notas de Voz)').first().json.message.message_id }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "1c3686b8-358a-4549-b6dd-cfd276d7d7bf",
      "name": "ElevenLabs → simulador (HTTP, solo prueba)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8083/v1/text-to-speech/EXAVITQu4vr4xnSDxMaL",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "output_format",
              "value": "mp3_44100_64"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "xi-api-key",
              "value": "simulada"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.respuesta_voz, model_id: \"eleven_multilingual_v2\", voice_settings: {\"stability\": 0.6, \"similarity_boost\": 0.8, \"style\": 0, \"use_speaker_boost\": true, \"speed\": 1} }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "9e293f25-057b-4890-a3cf-a798e91a1f36",
      "name": "Telegram · Send Audio (respuesta)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1720,
        200
      ],
      "parameters": {
        "operation": "sendAudio",
