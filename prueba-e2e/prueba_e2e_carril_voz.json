    {
      "id": "a266547c-c7f8-4ecb-beba-1a04a1069ef5",
      "name": "Telegram · Aviso Audio Inválido",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        760,
        800
      ],
      "parameters": {
        "chatId": "={{ $('Telegram Trigger (Notas de Voz)').first().json.message.chat.id }}",
        "text": "No pude entender tu nota de voz (llegó vacía, dañada o con mucho ruido). ¿Me la reenviás desde un lugar más tranquilo? También podés escribirme tu consulta.",
        "additionalFields": {
          "appendAttribution": false,
          "reply_to_message_id": "={{ $('Telegram Trigger (Notas de Voz)').first().json.message.message_id }}"
        }
      }
    },
    {
      "id": "bf083af0-b58e-4a7d-809e-780ad383af0f",
      "name": "🔒 Purga Binaria (Compliance)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        600
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// COMPLIANCE · destruccion binaria\n// El audio del cliente (Telegram) y el audio generado (ElevenLabs) solo viven en la\n// memoria volatil de esta ejecucion. Este nodo corta la cadena: no devuelve binarios,\n// ni la transcripcion, ni el chat_id. Con \"Save successful/failed executions = Do not save\"\n// n8n descarta los datos de la ejecucion al cerrarse el flujo.\nconst ruta = $prevNode.name === 'Telegram · Send Audio (respuesta)'\n  ? 'respuesta_de_voz'\n  : 'contingencia_audio_invalido';\n\nreturn $input.all().map(() => ({\n  json: {\n    canal: 'telegram_voz',\n    ruta,\n    binarios_retenidos: 0,\n    transcripcion_retenida: false,\n    cerrado_en: $now.toISO(),\n  },\n}));"
      }
    }
